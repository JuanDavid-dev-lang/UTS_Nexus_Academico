# Configuración del servicio de riesgo académico (FastAPI + scikit-learn).
#
# Copia este archivo a `.env` y ajústalo. Sin nada de esto el servicio arranca
# igual, escuchando solo en la máquina local: es lo que hace que un `git clone`
# funcione sin configurar.

# ── Dónde escucha ──────────────────────────────────────────────────────────
# 127.0.0.1 por defecto: el servicio no está pensado para recibir peticiones de
# fuera, solo del backend de Node que corre al lado.
#
# Si lo cambias a 0.0.0.0 o a una IP de la red, ML_SHARED_SECRET pasa a ser
# OBLIGATORIO y el servicio se niega a arrancar sin él. No es celo: `POST /train`
# reentrena y promueve el modelo que decide qué estudiantes salen marcados en
# rojo en las tres aplicaciones, y los cuatro `/vision/*` reciben archivos que
# abren opencv, pypdf y rapidocr — tres parsers nativos.
ML_HOST=127.0.0.1
ML_PORT=8100

# ── Secreto compartido con el backend ──────────────────────────────────────
# Viaja en la cabecera `X-ML-Secret`. Tiene que ser EL MISMO VALOR que
# `ML_SHARED_SECRET` en `backend/.env`.
#
# Vacío = sin autenticación, que solo es aceptable escuchando en la loopback.
# Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ML_SHARED_SECRET=

# ── Arranque ───────────────────────────────────────────────────────────────
# `1` evita entrenar el modelo de arranque al iniciar. Útil en las pruebas y en
# un contenedor que ya trae un modelo entrenado; en una instalación nueva
# déjalo apagado o el servicio responderá siempre con el motor de reglas.
ML_SKIP_BOOTSTRAP=0
