{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UTS Nexus Académico",
  "version": "2.6.1",
  "identifier": "co.edu.uts.nexus.academico",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5183",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "UTS Nexus Académico",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "center": true,
        "decorations": true,
        "transparent": false,
        "visible": false,
        "theme": null
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https: wss: http://127.0.0.1:* ws://127.0.0.1:* http://localhost:* ws://localhost:*"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENCQUFFRkRDNUE4NUY4NjMKUldSaitJVmEzTytxeTlaeSs1VXBUbUpRWDhaelpudmhpMitCUUxOQUEzK3hrK2hqZ1haY1JtdW0K",
      "endpoints": [
        "https://github.com/JuanDavid-dev-lang/UTS_Nexus_Releases/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "app", "dmg", "deb", "appimage"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Unidades Tecnológicas de Santander",
    "category": "Education",
    "shortDescription": "Gestión académica docente",
    "longDescription": "Cliente de escritorio de UTS Nexus Académico: notas, asistencia, riesgo académico y asistente de IA local.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish", "English"]
      }
    }
  }
}
