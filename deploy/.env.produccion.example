# ==============================================================================
#  UTS Nexus Académico — .env del servidor de producción (Nodo 1, ciaiuts.com)
# ==============================================================================
#
#  Destino: /srv/proyectos/nexus-backend/.env   (propietario nexus, modo 600)
#  Lo lee `nexus-backend.service` (EnvironmentFile=) y `dotenv` al arrancar.
#  `deploy/actualizar.sh` lo EXCLUYE del rsync: se edita a mano en el servidor
#  y no se versiona nunca con valores reales.
#
#  Tras editarlo:  sudo systemctl restart nexus-backend
#  Verificar:      cd /srv/proyectos/nexus-backend && node check-env.mjs
#
#  Genera cada secreto con:
#    node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ==============================================================================

# ── Proceso ───────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
# Solo la loopback: el único que llega al backend es el túnel de Cloudflare
# (nexusback.ciaiuts.com → 127.0.0.1:4000). Nada escucha hacia la red del clúster.
HOST=127.0.0.1
# Hay un proxy delante (cloudflared). Sin esto el límite de intentos de login
# vería la IP del túnel y contaría a toda la institución como un solo visitante.
TRUST_PROXY=1

# ── Base de datos ─────────────────────────────────────────────────────────
# Clúster de producción de Atlas, base `nexus_academico`.
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@cluster0.xxxxx.mongodb.net/nexus_academico?retryWrites=true&w=majority

# ── Sesión ────────────────────────────────────────────────────────────────
# Distintos entre sí y de al menos 32 caracteres: el arranque falla si no.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=15d

# ── CORS ──────────────────────────────────────────────────────────────────
# Solo el dominio público (Swagger y la página de descargas). Los orígenes de
# la app de escritorio (http://tauri.localhost, tauri://localhost) los añade el
# backend por su cuenta: NO van aquí. "*" está prohibido en producción.
# La versión web (Vercel) llama a esta API desde otro dominio: sin su origen
# aquí, el navegador corta la petición antes de enviarla y el inicio de sesión
# falla con «error de red» sin mencionar CORS por ninguna parte.
CLIENT_ORIGIN=https://nexusback.ciaiuts.com,https://utsnexusweb.ciaiuts.com
# Nunca en producción: convertiría /auth/recovery/request en una toma de cuenta.
ALLOW_DEV_RECOVERY_CODE=0

# ── Correo saliente (obligatorio en producción: recuperación de contraseña) ─
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=UTS Nexus Académico <no-reply@uts.edu.co>
# 1 solo si el puerto es 465 (TLS implícito). Con 587 va en 0 (STARTTLS).
SMTP_SECURE=0

# ── Tareas programadas ────────────────────────────────────────────────────
# Colombia: -300, sin horario de verano. El servidor corre en UTC; sin esto
# cada recordatorio llegaría cinco horas tarde.
CAMPUS_UTC_OFFSET_MIN=-300
CLASS_REMINDER_INTERVAL_MIN=1
RISK_SCAN_INTERVAL_MIN=60
ATTENDANCE_PATTERN_INTERVAL_MIN=60
ACTIVITY_DUE_INTERVAL_MIN=15
ANNOUNCEMENT_PUBLISH_INTERVAL_MIN=5
TELEMETRY_RETENTION_DAYS=90

# ── Asistente de IA (Ollama, daemon local del Nodo 1) ─────────────────────
AI_BASE_URL=http://127.0.0.1:11434
AI_MODEL=llama3.2:latest
AI_ENABLED=1

# ── Servicio de riesgo académico (Python) ─────────────────────────────────
# Si el servicio no corre en este nodo, ML_ENABLED=0 y el backend usa las
# reglas (`source: rules`). Si corre expuesto fuera de 127.0.0.1, el secreto
# es obligatorio y tiene que ser EL MISMO en el entorno del servicio.
ML_BASE_URL=http://127.0.0.1:8100
ML_ENABLED=0
ML_SHARED_SECRET=

# ── Notificaciones push a Android (FCM HTTP v1) ───────────────────────────
# Del JSON de la cuenta de servicio de Firebase. Sin las tres, no hay push con
# la app cerrada (los recordatorios de clase siguen: son alarmas locales).
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# Entre comillas dobles y con los saltos de línea escapados como \n.
FCM_PRIVATE_KEY=

# ── Puente con UniPlanner (Firestore del proyecto de UniPlanner) ──────────
UNIPLANNER_PROJECT_ID=
UNIPLANNER_CLIENT_EMAIL=
# Entre comillas dobles y con los saltos de línea escapados como \n.
UNIPLANNER_PRIVATE_KEY=
# 1 = ni avisos ni marcas de QR para enlaces sin verificar.
UNIPLANNER_SOLO_VERIFICADOS=0

# ── Aviso de versiones nuevas a los clientes ──────────────────────────────
RELEASES_REPO=JuanDavid-dev-lang/UTS_Nexus_Releases
RELEASE_CHECK_INTERVAL_H=6

# SEED_PASSWORD no va aquí: en una instalación real las cuentas de demo son
# cuentas conocidas.
