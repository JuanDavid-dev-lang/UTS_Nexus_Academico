# Proxy inverso con TLS automático.
#
# Caddy pide y renueva solo el certificado de Let's Encrypt. Con un nombre
# sslip.io —del tipo 52-1-2-3.sslip.io, que resuelve a esa misma IP— el desafío
# HTTP-01 funciona sin comprar dominio ni tocar DNS.
#
# Todo lo que llega por HTTP se redirige a HTTPS; Caddy lo hace por defecto.

{$DOMINIO} {
	encode zstd gzip

	# Cabeceras que el backend no puede poner porque no ve la conexión TLS.
	header {
		# Un año de HSTS: una vez visitado, el navegador se niega a usar HTTP.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	# Tope de cuerpo en el perímetro. Caddy no impone ninguno por defecto, así
	# que sin esto una subida de gigabytes llegaba hasta Node y solo la cortaba
	# multer, después de haberla transferido entera. El tope queda por encima
	# del archivo más grande que acepta la API —los 20 MB de un formato de
	# trabajo de grado— para que el límite real lo siga poniendo la ruta, con
	# su mensaje, y no un corte de conexión sin explicación.
	request_body {
		max_size 25MB
	}

	# El WebSocket de sincronización viaja por la misma ruta; Caddy conserva
	# los encabezados de actualización de protocolo sin configuración extra.
	reverse_proxy backend:4000 {
		header_up X-Real-IP {remote_host}
	}
}
