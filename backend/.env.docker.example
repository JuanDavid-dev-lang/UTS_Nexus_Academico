# Entorno del backend en `docker-compose.local.yml`. Cópialo a `.env.docker`.
#
# La base, el host, CORS y las integraciones externas los fija el compose:
# aquí van solo los secretos y lo que quieras encender.
#
# Genera cada secreto con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Los dos JWT tienen que ser distintos y de 32 caracteres o más: el backend no
# arranca si no, aunque la base sea la del contenedor.

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Contraseña de las cuentas de demo que crea el seed. Vacía, el seed genera una
# al azar y la imprime una sola vez.
SEED_PASSWORD=

# Servicio de ML (perfil `ml` del compose). Con ML_ENABLED=0, o sin levantar el
# perfil, el backend usa el motor de reglas y lo declara en `source`.
ML_ENABLED=0
ML_SHARED_SECRET=

# Asistente conversacional (Ollama). Desde el contenedor, un Ollama del propio
# equipo es http://host.docker.internal:11434, no localhost.
AI_ENABLED=0
AI_BASE_URL=http://host.docker.internal:11434
AI_MODEL=llama3.2:latest
