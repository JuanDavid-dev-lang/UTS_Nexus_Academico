PORT=4000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/uts_academico?retryWrites=true&w=majority
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
CLIENT_ORIGIN=http://localhost:3000
# `1` cuando hay un proxy inverso delante (Caddy, Nginx, un túnel). Activa
# `trust proxy`, que es lo que hace que el límite de intentos de login vea la IP
# real del cliente en vez de la del proxy y no cuente a toda la institución como
# un solo visitante. Sin declarar, sigue a NODE_ENV. NO la actives sin proxy
# delante: cualquiera podría inventarse su `X-Forwarded-For` y estrenar cupo.
TRUST_PROXY=

# Devuelve el código de recuperación EN LA RESPUESTA de /auth/recovery/request,
# solo fuera de producción y solo si no hay SMTP configurado. Existe para poder
# recuperar una contraseña en una instalación local sin servidor de correo.
# Nunca en un servidor al que llegue nadie más: convierte esa ruta en una toma
# de cuenta de un solo paso, porque basta conocer un correo del directorio.
ALLOW_DEV_RECOVERY_CODE=0
# Minutos entre escaneos automáticos de riesgo académico. 0 = desactivado.
RISK_SCAN_INTERVAL_MIN=0

# ── Asistente de IA local (Ollama) ────────────────────────────────────────
# URL del servidor Ollama local (por defecto http://localhost:11434).
AI_BASE_URL=http://localhost:11434
# Modelo a usar (debe estar descargado: `ollama pull llama3.1:8b`).
AI_MODEL=llama3.1:8b
# 1 = chatbot inteligente con IA local activado · 0 = modo reglas (sin IA).
AI_ENABLED=1


# ── Agenda académica ──────────────────────────────────────────────────────
# Desfase del campus respecto a UTC, en minutos. Colombia: -300 (sin horario
# de verano). "10:00" en un horario son las diez EN EL CAMPUS: si el servidor
# corre en UTC y esto no se declara, el recordatorio llega cinco horas tarde.
CAMPUS_UTC_OFFSET_MIN=-300
# Minutos entre pasadas del recordatorio de clases. 0 = desactivado.
# Va a 1 por defecto: un aviso de "empieza en 15 minutos" comprobado cada
# cuarto de hora no es un aviso.
CLASS_REMINDER_INTERVAL_MIN=1

# ── Notificaciones push a Android (Firebase Cloud Messaging, HTTP v1) ─────
# Opcional. Sin estas tres variables NO se envía nada con la app cerrada y
# queda anotado en el log; los recordatorios de clase siguen llegando porque
# Android los programa como alarmas locales. Se sacan del JSON de la cuenta
# de servicio de Firebase (Configuración del proyecto › Cuentas de servicio).
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# Entre comillas y con los saltos de línea escapados como \n.
FCM_PRIVATE_KEY=

# ── Servicio de riesgo académico (Python + scikit-learn) ──────────────────
ML_BASE_URL=http://127.0.0.1:8100
ML_ENABLED=1
# Secreto compartido con el servicio de ML; viaja en la cabecera `X-ML-Secret`.
# Vacío mientras el servicio escuche solo en 127.0.0.1, que es lo que hace por
# defecto. En cuanto se exponga hay que ponerlo: `POST /train` reentrena el
# modelo que decide qué estudiantes salen marcados en rojo, y `/vision/*`
# acepta archivos que abren opencv, pypdf y rapidocr. El servicio se niega a
# arrancar expuesto y sin secreto. Tiene que ser EL MISMO VALOR que
# `ML_SHARED_SECRET` en el entorno del servicio de Python.
ML_SHARED_SECRET=

# ── Datos de demostración ───────────────────────────────────────────────────
# Contraseña de las cuentas que crea `npm run seed`. Sin ella el seed genera una
# al azar y la muestra UNA vez al terminar: cómodo para un despliegue, incómodo
# para desarrollar, donde se resiembra a menudo y hay que volver a copiarla.
# Nunca la pongas en una instalación real: son cuentas conocidas.
SEED_PASSWORD=
