PORT=4000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/uts_academico?retryWrites=true&w=majority
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
CLIENT_ORIGIN=http://localhost:3000
# Minutos entre escaneos automáticos de riesgo académico. 0 = desactivado.
RISK_SCAN_INTERVAL_MIN=0

# ── Asistente de IA local (Ollama) ────────────────────────────────────────
# URL del servidor Ollama local (por defecto http://localhost:11434).
AI_BASE_URL=http://localhost:11434
# Modelo a usar (debe estar descargado: `ollama pull llama3.1:8b`).
AI_MODEL=llama3.1:8b
# 1 = chatbot inteligente con IA local activado · 0 = modo reglas (sin IA).
AI_ENABLED=1


# ── Agenda académica ──────────────────────────────────────────────────────
# Desfase del campus respecto a UTC, en minutos. Colombia: -300 (sin horario
# de verano). "10:00" en un horario son las diez EN EL CAMPUS: si el servidor
# corre en UTC y esto no se declara, el recordatorio llega cinco horas tarde.
CAMPUS_UTC_OFFSET_MIN=-300
# Minutos entre pasadas del recordatorio de clases. 0 = desactivado.
# Va a 1 por defecto: un aviso de "empieza en 15 minutos" comprobado cada
# cuarto de hora no es un aviso.
CLASS_REMINDER_INTERVAL_MIN=1

# ── Notificaciones push a Android (Firebase Cloud Messaging, HTTP v1) ─────
# Opcional. Sin estas tres variables NO se envía nada con la app cerrada y
# queda anotado en el log; los recordatorios de clase siguen llegando porque
# Android los programa como alarmas locales. Se sacan del JSON de la cuenta
# de servicio de Firebase (Configuración del proyecto › Cuentas de servicio).
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# Entre comillas y con los saltos de línea escapados como \n.
FCM_PRIVATE_KEY=

# ── Datos de demostración ───────────────────────────────────────────────────
# Contraseña de las cuentas que crea `npm run seed`. Sin ella el seed genera una
# al azar y la muestra UNA vez al terminar: cómodo para un despliegue, incómodo
# para desarrollar, donde se resiembra a menudo y hay que volver a copiarla.
# Nunca la pongas en una instalación real: son cuentas conocidas.
SEED_PASSWORD=
